# Resend API Key (Obtén tu API key en https://resend.com/api-keys)
VITE_RESEND_API_KEY=tu_resend_api_key_aqui

# Correo remitente oficial de Resend (Dominio brvents.com)
VITE_FROM_EMAIL=BR Events <notificaciones@brvents.com>

# Correo electrónico de la Administración para alertas internas
VITE_ADMIN_EMAIL=admin@brvents.com

# Supabase (Opcional - La app cuenta con fallback dinámico y LocalStorage)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
